msgstr "Inspecter les profils publics liés à votre institution."

#: app/templates/help/index.html:105
msgid "Explore ORCID analytics"
msgstr "Explorer les analyses ORCID"

#: app/templates/help/index.html:105
msgid "Filter works, funding, and researcher indicators."
msgstr "Filtrez les indicateurs de publications, de financements et de chercheurs."

#: app/templates/help/index.html:106
msgid "Explore OpenAlex analytics"
msgstr "Explorer les analyses OpenAlex"

#: app/templates/help/index.html:106
msgid "Review citations, access, languages, topics, and sources."
msgstr "Examiner les citations, l'accès, les langues, les sujets et les sources."

#: app/templates/help/index.html:107
msgid "Review datasets"
msgstr "Examiner les ensembles de données"

#: app/templates/help/index.html:107
