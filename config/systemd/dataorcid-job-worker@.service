[Unit]
Description=DataOrcid-Chile background job worker %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/html/orcid-cincel
Environment=PYTHONUNBUFFERED=1
Environment=FLASK_APP=run.py
Environment=JOB_EXECUTION_MODE=queue
ExecStart=/var/www/html/orcid-cincel/venv/bin/flask run-job-worker
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
