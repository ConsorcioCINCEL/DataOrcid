#: app/templates/help/index.html:108
msgid "Understand coverage, provenance, and known limitations."
msgstr "Verstehen Sie Abdeckung, Herkunft und bekannte Einschränkungen."

#: app/templates/help/index.html:109
msgid "Review duplicate candidates"
msgstr "Prüfung Duplikatkandidaten"

#: app/templates/help/index.html:109
