# ============================================================
# DataOrcid-Chile — Configuration Example File
# Author: Gastón Olivares
# License: MIT
# ============================================================
# This file is a configuration template.
# Copy it to `config/config.toml` and adjust values for your environment.
# ============================================================


# ------------------------------------------------------------
# 🔹 DATABASE
# ------------------------------------------------------------
[database]
# Format: dialect+driver://user:password@host/dbname
# PostgreSQL:
uri = "postgresql+psycopg://USER:PASS@localhost:5432/dataorcid_chile"
# MySQL (legacy):
# uri = "mysql+pymysql://USER:PASS@localhost/dataorcid_chile"


# ------------------------------------------------------------
# 🔹 FLASK CONFIGURATION
# ------------------------------------------------------------
[flask]
secret_key = "CHANGEME_IN_RUNTIME"
password_salt = "CHANGE_ME_SALT"
session_cookie_secure = true
session_cookie_httponly = true
session_cookie_samesite = "Lax"
# Keep this true only for a local development configuration.
allow_insecure_dev_config = true
permanent_session_days = 31


# ------------------------------------------------------------
# 🔹 LANGUAGES (i18n)
# ------------------------------------------------------------
[languages]
supported = ["en", "es", "fr", "pt", "de"]
default = "en"


# ------------------------------------------------------------
# 🔹 INTERNAL PATHS
# ------------------------------------------------------------
[paths]
datasets_dir = "app/datasets"


# ------------------------------------------------------------
# 🔹 GENERAL APP CONFIGURATION
# ------------------------------------------------------------
[app]
base_url = "http://localhost:5000"
version = "2.1"
environment = "development"

[proxy]
# Number of explicitly trusted reverse-proxy hops. Leave at zero when Flask is
# exposed directly; never enable this merely to accept arbitrary X-Forwarded-*.
trusted_hops = 0

[cache]
# Shared freshness threshold used by summary, cache, and quality views.
stale_days = 30

[jobs]
# "thread" preserves the convenient single-process development behavior.
# Use "queue" in multi-worker production and run `flask run-job-worker` as a
# separate supervised process.
execution_mode = "thread"
stale_minutes = 30
max_attempts = 3
# Independent lease refresh for jobs blocked in long API or spreadsheet work.
heartbeat_seconds = 30

[exports]
# Generated files stay outside the public static tree and are removed after the
# retention period. Relative paths are resolved from the repository root. In a
# distributed deployment this directory must be shared by web and job workers.
directory = "instance/exports"
retention_hours = 24
# These limits keep accidental repeated clicks or automated requests from
# creating an unbounded backlog. The shared worker limit still controls CPU use.
max_active_per_user = 3
max_active_global = 20

[tracking]
# Apply with: flask cleanup-tracking-logs
retention_days = 90
# Runtime exceptions and application ERROR logs are stored separately for the
# administrator diagnostics module. Request payloads and credentials are never
# included. Apply retention with: flask cleanup-system-errors
error_monitoring_enabled = true
error_retention_days = 90


# ------------------------------------------------------------
# 🔹 ORCID CONFIGURATION
# ------------------------------------------------------------
[orcid]
base_url_public  = "https://pub.orcid.org/v3.0/"
base_url_member  = "https://api.orcid.org/v3.0/"
search_url       = "https://api.orcid.org/v3.0/"
token_url      = "https://orcid.org/oauth/token"
client_id      = "APP-XXXXXX"
client_secret = "REPLACE_OR_USE_ENV"
profile_cache_ttl = 900


# ------------------------------------------------------------
# 🔹 OPENALEX CONFIGURATION
# ------------------------------------------------------------
[openalex]
base_url = "https://api.openalex.org"
# Prefer the OPENALEX_API_KEY environment variable in production.
api_key = "REPLACE_OR_USE_ENV"
# Optional contact email for operational follow-up.
mailto = "support@your-domain.cl"
timeout = 20
stale_days = 30
# Failed requests use exponential backoff from this initial delay up to the cap.
error_retry_minutes = 15
error_retry_max_hours = 24
# Parallel DOI fetch workers for OpenAlex sync. Start with 4; raise carefully.
workers = 4
# Title fallback is heavier than DOI lookup; keep it lower to avoid 429s.
title_workers = 2
# Seconds to keep institutional and global analytics in memory and on disk.
# Data changes create a new cache key, so a one-day TTL avoids needless rebuilds.
analytics_cache_ttl = 86400


# ------------------------------------------------------------
# 🔹 OAI-PMH CONFIGURATION
# ------------------------------------------------------------
[oai]
# Number of records returned in each provider response page.
provider_page_size = 100
# Signed resumption tokens expire after this many seconds.
resumption_token_max_age = 3600


# ------------------------------------------------------------
# 🔹 EMAIL CONFIGURATION (SMTP)
# ------------------------------------------------------------
[mail]
enabled      = true
smtp_host    = "smtp.gmail.com"
smtp_port    = 587
use_tls      = true
use_ssl      = false
smtp_user    = "your-email@cincel.cl"
smtp_pass    = "your-app-password"
from_name    = "Data ORCID-Chile"
from_email   = "your-email@cincel.cl"
reply_to     = "support@your-domain.cl"
