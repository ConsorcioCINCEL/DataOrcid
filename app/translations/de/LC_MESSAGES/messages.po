#: app/templates/works/openalex_global.html:554
msgid "Open Access Mix"
msgstr "Open Access Mix"

#: app/templates/works/openalex_global.html:556
msgid "Global share of open and closed articles."
msgstr "Globaler Anteil offener und geschlossener Artikel."

