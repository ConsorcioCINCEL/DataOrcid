#: app/blueprints/admin.py app/templates/admin/modules.html
msgid "Default landing page language"
msgstr "Idioma predeterminado de la página de presentación"

#: app/blueprints/admin.py app/templates/admin/modules.html
msgid ""
"Shown to visitors who have not chosen a language. Their language selection "
